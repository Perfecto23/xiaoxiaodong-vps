---
// 外壳：顶栏（主题切换 + GitHub）、左侧导航（主线 7 步 + 栏目）、正文、右侧目录。界面全部用 xxd-ui-kit。
import { STEPS, stepHref, HOWTO, HOWTO_FLAT, howtoHref, wikiHref, link } from "../data/nav.js";
import { WIKI } from "../data/wiki.js";
import { FAQ } from "../data/faq.js";

interface Props {
  title: string;
  description?: string;
  headings?: { slug: string; text: string; depth: number }[];
  wide?: boolean;
}
const BRAND = "小小东 VPS 教程";
const { title, description = "从买服务器到用上自己的线路和 AI 接口：一步一步、看得懂、照着做就会。", headings = [], wide = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const cur = (href) => (href.replace(/\/$/, "") || "/") === path;
const toc = headings.filter((h) => h.depth === 2); // 只列二级标题：标签页里的小标题不进目录
const REPO = "https://github.com/nevertoday/xiaoxiaodong-vps";
// 搜索：主线每一步、每篇 How-to、每个 Wiki 条目、每条常见问题（xxd 的命令面板，⌘K 打开）
const searchIndex = JSON.stringify([
  ...STEPS.map((x) => ({ label: `${x.n}. ${x.title}`, hint: "主线教程", keywords: x.sum, href: stepHref(x) })),
  ...HOWTO_FLAT.map((x) => ({ label: x.title, hint: `How-to · ${x.group}`, keywords: x.group, href: howtoHref(x.slug) })),
  ...WIKI.map((x) => ({ label: x.title, hint: `Wiki · ${x.group}`, keywords: x.one, href: wikiHref(x.slug) })),
  ...FAQ.flatMap((g) => g.items.map(([q, a]) => ({ label: q, hint: `常见问题 · ${g.title}`, keywords: a.slice(0, 80), href: link(`/faq/#${g.id}`) }))),
]);
const GITHUB_MARK = '<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"/></svg>';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === BRAND ? title : `${title} · ${BRAND}`}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={link("/favicon.svg")} type="image/svg+xml" />
    <style is:inline>@layer base, xxd, components, site;</style>
    <script is:inline src={link("/xxd/boot.js")} data-key="xxd-vps-site" data-default-theme="system"></script>
    <link rel="stylesheet" href={link("/xxd/xxd.css")} />
    <link rel="stylesheet" href={link("/site.css")} />
    <script is:inline src={link("/xxd/icons.js")}></script>
    <script is:inline src={link("/xxd/xxd.js")}></script>
  </head>
  <body class="xxd-page">
    <a class="xxd-sr-only-focusable" href="#main">跳到正文</a>
    <header class="site-top">
      <button class="xxd-btn site-menu" data-variant="ghost" data-icon-only aria-label="打开目录" id="site-menu" aria-controls="site-nav" aria-expanded="false"><i data-xxd-icon="Menu" data-size="18"></i></button>
      <a class="site-brand" href={link("/")}><span class="site-mark" aria-hidden="true"></span><span class="site-brand__name">{BRAND}</span></a>
      <button class="site-search" id="site-search" type="button"><i data-xxd-icon="Search" data-size="14"></i><span>搜索教程</span><kbd class="xxd-kbd">⌘K</kbd></button>
      <span class="site-top__spacer"></span>
      <div class="site-appearance">
        <div class="xxd-segmented" data-xxd-segmented data-name="theme" aria-label="主题" id="site-theme">
          <button role="radio" data-value="light" aria-label="亮色" data-tooltip="亮色" data-tooltip-placement="bottom"><i data-xxd-icon="Sun" data-size="14"></i></button>
          <button role="radio" data-value="dark" aria-label="暗色" data-tooltip="暗色" data-tooltip-placement="bottom"><i data-xxd-icon="Moon" data-size="14"></i></button>
          <button role="radio" data-value="system" aria-label="跟随系统" data-tooltip="跟随系统" data-tooltip-placement="bottom"><i data-xxd-icon="Contrast" data-size="14"></i></button>
        </div>
        <a class="xxd-btn" data-size="sm" data-variant="ghost" data-icon-only href={REPO} aria-label="GitHub 仓库" data-tooltip="GitHub 仓库" data-tooltip-placement="bottom-end" set:html={GITHUB_MARK} />
      </div>
    </header>

    <div class="site-body">
      <nav class="site-nav" id="site-nav" aria-label="网站目录">
        <section class="site-nav__group">
          <h2>开始</h2>
          <ul><li><a href={link("/")} aria-current={cur(link("/")) ? "page" : undefined}><span class="site-nav__label">首页：一张图看懂</span></a></li></ul>
        </section>
        <section class="site-nav__group">
          <h2>主线教程（按顺序做）</h2>
          <ul>
            {STEPS.map((s) => (
              <li>
                {s.ready ? (
                  <a href={stepHref(s)} aria-current={cur(stepHref(s)) ? "page" : undefined}>
                    <span class="site-nav__num">{s.n}</span><span class="site-nav__label">{s.title}</span>
                  </a>
                ) : (
                  <span class="is-pending"><span class="site-nav__num">{s.n}</span><span class="site-nav__label">{s.title}</span><span class="site-nav__tag">编写中</span></span>
                )}
              </li>
            ))}
          </ul>
        </section>
        <section class="site-nav__group">
          <h2>查资料</h2>
          <ul>
            <li><a href={link("/howto/")} aria-current={cur(link("/howto/")) ? "page" : undefined}><span class="site-nav__label">How-to：具体怎么做</span></a></li>
            <li><a href={link("/wiki/")} aria-current={cur(link("/wiki/")) ? "page" : undefined}><span class="site-nav__label">Wiki：这是什么</span></a></li>
            <li><a href={link("/faq/")} aria-current={cur(link("/faq/")) ? "page" : undefined}><span class="site-nav__label">常见问题</span></a></li>
          </ul>
        </section>
        {HOWTO.map((g) => (
          <details class="site-nav__more" open={g.items.some((t) => cur(howtoHref(t.slug)))}>
            <summary>{g.group}</summary>
            <ul>{g.items.map((t) => <li><a href={howtoHref(t.slug)} aria-current={cur(howtoHref(t.slug)) ? "page" : undefined}><span class="site-nav__label">{t.title}</span></a></li>)}</ul>
          </details>
        ))}
      </nav>

      <main id="main" class:list={["site-main", { "site-main--wide": wide }]}>
        <slot />
        <footer class="site-foot">
          <p>这套方案只给自己和家人用，请遵守当地法律和各网站、AI 工具的使用规定。内容开源（MIT），源码和问题反馈在 <a href={REPO}>GitHub</a>。</p>
        </footer>
      </main>

      {toc.length > 1 && (
        <aside class="site-toc" aria-label="本页目录">
          <h2>本页</h2>
          <ul>{toc.map((h) => <li class={h.depth === 3 ? "is-sub" : undefined}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul>
        </aside>
      )}
    </div>
    <div class="site-nav-scrim" id="site-nav-scrim"></div>

    <script type="application/json" id="site-search-index" set:html={searchIndex} />
    <script is:inline>
      (() => {
        const T = window.XxdTheme, X = window.Xxd;
        if (!T || !X) return;
        // 主题：读当前设置，改了写回（boot.js 已在首帧前应用）
        const seg = document.getElementById("site-theme");
        const sync = () => {
          const s = { ...T.DEFAULT_SETTINGS, ...T.read() };
          for (const b of seg.querySelectorAll('[role="radio"]')) {
            const on = b.dataset.value === String(s.theme);
            b.setAttribute("aria-checked", String(on));
            b.tabIndex = on ? 0 : -1;
          }
        };
        seg.addEventListener("xxd:change", (e) => { T.set({ theme: e.detail.value }); sync(); });
        X.init(document);
        sync();

        // 搜索：⌘K / 点按钮，用 xxd 的命令面板
        const pages = JSON.parse(document.getElementById("site-search-index").textContent);
        const items = pages.map((p) => ({ label: p.label, hint: p.hint, keywords: p.keywords, run: () => { location.href = p.href; } }));
        const opts = { placeholder: "搜步骤、How-to、名词、问题……", empty: "没找到，换个词试试" };
        document.getElementById("site-search").addEventListener("click", () => X.openCommandPalette({ items, ...opts }));
        X.bindCommandPalette(items, opts);

        // 窄屏目录抽屉
        const nav = document.getElementById("site-nav"), scrim = document.getElementById("site-nav-scrim"), menu = document.getElementById("site-menu");
        const toggle = (on) => {
          nav.toggleAttribute("data-open", on); scrim.toggleAttribute("data-open", on);
          menu.setAttribute("aria-expanded", String(on));
          if (on) (nav.querySelector('[aria-current="page"]') || nav.querySelector("a"))?.focus();
          else if (nav.contains(document.activeElement)) menu.focus();
        };
        menu.addEventListener("click", () => toggle(!nav.hasAttribute("data-open")));
        scrim.addEventListener("click", () => toggle(false));
        nav.addEventListener("keydown", (e) => { if (e.key === "Escape" && nav.hasAttribute("data-open")) { e.preventDefault(); toggle(false); } });

        // 检查点：打勾只存在这个浏览器里；存不了（无痕、禁用存储）也照常能勾
        for (const box of document.querySelectorAll("[data-checkpoint]")) {
          const key = "xxd-vps-check:" + box.dataset.checkpoint;
          const inputs = [...box.querySelectorAll("input[type=checkbox]")];
          const done = box.querySelector(".checkpoint__done");
          let saved = [];
          try { saved = JSON.parse(localStorage.getItem(key) || "[]"); } catch {}
          inputs.forEach((el, i) => { el.checked = !!saved[i]; });
          const update = () => {
            const all = inputs.every((el) => el.checked);
            if (done) done.hidden = !all;
            try { localStorage.setItem(key, JSON.stringify(inputs.map((el) => el.checked))); } catch {}
          };
          inputs.forEach((el) => el.addEventListener("change", update));
          update();
        }
      })();
    </script>
  </body>
</html>
