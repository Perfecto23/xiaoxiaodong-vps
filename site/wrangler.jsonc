// 教程站部署到 Cloudflare（纯静态，Workers 静态资源）：https://vps.xiaoxiaodong.ai
// 部署：npm run release（先构建再 wrangler deploy）
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "xxd-vps-site",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [{ "pattern": "vps.xiaoxiaodong.ai", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
